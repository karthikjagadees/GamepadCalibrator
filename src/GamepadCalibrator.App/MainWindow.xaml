<Window x:Class="GamepadCalibrator.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:GamepadCalibrator.App.Converters"
        Title="My Gamepad — Setup &amp; Play"
        WindowState="Maximized"
        Height="860" Width="1280"
        MinHeight="720" MinWidth="1100"
        WindowStartupLocation="CenterScreen">
  <Window.Resources>
    <conv:BoolToBrushConverter x:Key="BoolBrush"/>
    <Style x:Key="SlotCard" TargetType="Border">
      <Setter Property="Background" Value="#162033"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,0,0,8"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="BorderBrush" Value="#2A3A55"/>
    </Style>
    <Style x:Key="SectionTitle" TargetType="TextBlock">
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,4"/>
      <Setter Property="Foreground" Value="#F8FAFC"/>
    </Style>
    <Style x:Key="HelpText" TargetType="TextBlock">
      <Setter Property="FontSize" Value="13"/>
      <Setter Property="Foreground" Value="#94A3B8"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
      <Setter Property="LineHeight" Value="20"/>
      <Setter Property="Margin" Value="0,0,0,12"/>
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="14"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Foreground" Value="#E2E8F0"/>
      <Setter Property="Width" Value="130"/>
    </Style>
  </Window.Resources>

  <DockPanel Margin="20">
    <!-- Header -->
    <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Margin="0,0,0,14" Padding="18,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <StackPanel VerticalAlignment="Center">
          <TextBlock Text="My Gamepad" FontSize="26" FontWeight="Bold" Foreground="#F8FAFC"/>
          <TextBlock Text="{Binding ConnectionStatus}" Style="{StaticResource HelpText}" Margin="0,6,0,0" FontSize="14"/>
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock Text="Controller:" VerticalAlignment="Center" Margin="0,0,10,0" FontSize="14" Foreground="#CBD5E1"/>
          <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}"
                    DisplayMemberPath="DisplayLabel" Width="340" Height="34" FontSize="13" Margin="0,0,10,0"/>
          <Button Content="Find gamepads" Command="{Binding RefreshDevicesCommand}" Height="34" Padding="16,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <TabControl FontSize="14">
      <!-- SET CONTROLS — main simple UI -->
      <TabItem Header="1. Set Controls">
        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
          <StackPanel>
            <Border Style="{StaticResource Card}" Padding="18">
              <StackPanel>
                <TextBlock Text="Tell the app what each button should do" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource HelpText}"
                           Text="Press a button on your gamepad — the matching row lights up. Then choose an action from the dropdown (for example: Button 8 → Shoot, D-pad Up → Use). When you are happy, click Start Playing and open your game."/>
                <TextBlock Text="{Binding RemapStatus}" FontSize="15" FontWeight="SemiBold" Foreground="#38BDF8" TextWrapping="Wrap" Margin="0,0,0,14"/>

                <WrapPanel Margin="0,0,0,8">
                  <Button Content="Start Playing" Command="{Binding StartRemapCommand}" Background="#16A34A" Height="40" Padding="22,0" FontSize="15" FontWeight="SemiBold"/>
                  <Button Content="Stop" Command="{Binding StopRemapCommand}" Background="#DC2626" Height="40" Padding="22,0" FontSize="15"/>
                  <Button Content="Load FPS layout" Command="{Binding ApplyFpsPresetCommand}" Height="40" Padding="16,0"/>
                  <Button Content="Clear all" Command="{Binding ClearAllActionsCommand}" Height="40" Padding="16,0" Background="#475569"/>
                  <Button Content="Save my setup" Command="{Binding SaveProfileCommand}" Height="40" Padding="16,0"/>
                  <Button Content="Load saved setup" Command="{Binding LoadProfileCommand}" Height="40" Padding="16,0"/>
                </WrapPanel>

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <TextBlock Text="Camera speed" Style="{StaticResource FieldLabel}" Width="120"/>
                  <Slider Width="200" Minimum="4" Maximum="60" VerticalAlignment="Center"
                          Value="{Binding Profile.Remap.CameraSpeed}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                  <TextBlock Text="{Binding Profile.Remap.CameraSpeed, StringFormat={}{0:F0}}" VerticalAlignment="Center" Margin="10,0,24,0" Width="28"/>
                  <TextBlock Text="Stick dead zone" Style="{StaticResource FieldLabel}" Width="130"/>
                  <Slider Width="160" Minimum="0" Maximum="0.3" VerticalAlignment="Center"
                          Value="{Binding Profile.Remap.StickDeadZone}" TickFrequency="0.01" IsSnapToTickEnabled="True"/>
                  <TextBlock Text="{Binding Profile.Remap.StickDeadZone, StringFormat={}{0:P0}}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <!-- Buttons -->
              <Border Style="{StaticResource Card}" Margin="0,0,8,0">
                <StackPanel>
                  <TextBlock Text="Buttons" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Style="{StaticResource HelpText}" Text="Example: Button 8 = Shoot, Button 5 = Reload. Change any row."/>
                  <ItemsControl ItemsSource="{Binding ButtonSlots}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Style="{StaticResource SlotCard}" Background="{Binding IsPressed, Converter={StaticResource BoolBrush}}">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="120"/>
                              <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                              <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15"/>
                              <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                            </StackPanel>
                            <ComboBox Grid.Column="1" Margin="12,0,0,0" Height="34" FontSize="13"
                                      ItemsSource="{Binding Actions}"
                                      SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                      DisplayMemberPath="Display"
                                      VerticalContentAlignment="Center"/>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>

              <!-- D-pad + sticks -->
              <StackPanel Grid.Column="1" Margin="8,0,0,0">
                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="D-pad" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource HelpText}" Text="Example: D-pad Up = Use (E). Pick what you want for each direction."/>
                    <ItemsControl ItemsSource="{Binding DpadSlots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource SlotCard}" Background="{Binding IsPressed, Converter={StaticResource BoolBrush}}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                              </StackPanel>
                              <ComboBox Grid.Column="1" Margin="12,0,0,0" Height="34" FontSize="13"
                                        ItemsSource="{Binding Actions}"
                                        SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                        DisplayMemberPath="Display"
                                        VerticalContentAlignment="Center"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <Border Style="{StaticResource Card}">
                  <StackPanel>
                    <TextBlock Text="Sticks (camera / look)" Style="{StaticResource SectionTitle}"/>
                    <TextBlock Style="{StaticResource HelpText}" Text="Usually Left stick = look around with the mouse. You can change this."/>
                    <ItemsControl ItemsSource="{Binding StickSlots}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Border Style="{StaticResource SlotCard}">
                            <Grid>
                              <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="*"/>
                              </Grid.ColumnDefinitions>
                              <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Title}" FontWeight="Bold" FontSize="15"/>
                                <TextBlock Text="{Binding Hint}" FontSize="11" Foreground="#94A3B8" TextWrapping="Wrap"/>
                              </StackPanel>
                              <ComboBox Grid.Column="1" Margin="12,0,0,0" Height="34" FontSize="13"
                                        ItemsSource="{Binding Actions}"
                                        SelectedItem="{Binding SelectedAction, Mode=TwoWay}"
                                        DisplayMemberPath="Display"
                                        VerticalContentAlignment="Center"/>
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- CALIBRATE -->
      <TabItem Header="2. Calibrate">
        <ScrollViewer>
          <StackPanel Margin="4">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Make the sticks feel correct" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource HelpText}"
                           Text="If the camera drifts or a stick feels wrong, run these steps. Keep your hands off the sticks for Center. Move sticks in full circles for Range. If your pad has an ANALOG button, turn it on first."/>
                <TextBlock Text="{Binding WizardPrompt}" TextWrapping="Wrap" MinHeight="48" FontSize="14" Margin="0,0,0,12"/>
                <WrapPanel>
                  <Button Content="1. Find which stick is which" Command="{Binding RunAxisDiscoveryCommand}" Height="40" Padding="14,0"/>
                  <Button Content="2. Center (hands off)" Command="{Binding CalibrateCentersCommand}" Height="40" Padding="14,0"/>
                  <Button Content="3. Range (move sticks)" Command="{Binding CalibrateRangesCommand}" Height="40" Padding="14,0"/>
                  <Button Content="Reset calibration" Command="{Binding ResetCalibrationCommand}" Background="#B91C1C" Height="40" Padding="14,0"/>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Warnings" Style="{StaticResource SectionTitle}" Foreground="#FBBF24"/>
                <ItemsControl ItemsSource="{Binding Warnings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <TextBlock Text="{Binding}" TextWrapping="Wrap" Margin="0,0,0,8" FontSize="13"/>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="{Binding AnalogModeHelp}" Style="{StaticResource HelpText}" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>

      <!-- TEST -->
      <TabItem Header="3. Test">
        <ScrollViewer>
          <Grid Margin="4">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="280"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Left stick" Style="{StaticResource SectionTitle}"/>
                <Border Width="220" Height="220" Background="#0B1220" CornerRadius="8" Margin="0,8,0,8" HorizontalAlignment="Left">
                  <Canvas Width="220" Height="220">
                    <Ellipse Width="120" Height="120" Stroke="#334155" StrokeThickness="1" Canvas.Left="50" Canvas.Top="50"/>
                    <Ellipse Width="16" Height="16" Fill="#38BDF8" Canvas.Left="{Binding LeftDotX}" Canvas.Top="{Binding LeftDotY}"/>
                  </Canvas>
                </Border>
                <TextBlock Text="{Binding LeftNormX, StringFormat=X: {0:F2}}" FontSize="14"/>
                <TextBlock Text="{Binding LeftNormY, StringFormat=Y: {0:F2}}" FontSize="14"/>
              </StackPanel>
            </Border>
            <Border Grid.Column="1" Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Right stick" Style="{StaticResource SectionTitle}"/>
                <Border Width="220" Height="220" Background="#0B1220" CornerRadius="8" Margin="0,8,0,8" HorizontalAlignment="Left">
                  <Canvas Width="220" Height="220">
                    <Ellipse Width="120" Height="120" Stroke="#334155" StrokeThickness="1" Canvas.Left="50" Canvas.Top="50"/>
                    <Ellipse Width="16" Height="16" Fill="#A78BFA" Canvas.Left="{Binding RightDotX}" Canvas.Top="{Binding RightDotY}"/>
                  </Canvas>
                </Border>
                <TextBlock Text="{Binding RightNormX, StringFormat=X: {0:F2}}" FontSize="14"/>
                <TextBlock Text="{Binding RightNormY, StringFormat=Y: {0:F2}}" FontSize="14"/>
              </StackPanel>
            </Border>
            <StackPanel Grid.Column="2">
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="D-pad" Style="{StaticResource SectionTitle}"/>
                  <TextBlock Text="{Binding HatLabel}" FontSize="20" HorizontalAlignment="Center" Margin="0,12"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource Card}">
                <StackPanel>
                  <TextBlock Text="Buttons" Style="{StaticResource SectionTitle}"/>
                  <ItemsControl ItemsSource="{Binding ButtonRows}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <Border Width="52" Height="44" Margin="3" CornerRadius="6"
                                Background="{Binding IsPressed, Converter={StaticResource BoolBrush}}">
                          <TextBlock Text="{Binding Index}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
            </StackPanel>
          </Grid>
        </ScrollViewer>
      </TabItem>

      <!-- ADVANCED -->
      <TabItem Header="4. Advanced">
        <ScrollViewer>
          <StackPanel Margin="4">
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Raw axis values" Style="{StaticResource SectionTitle}"/>
                <TextBlock Style="{StaticResource HelpText}" Text="For troubleshooting only. Normal users can ignore this tab."/>
                <DataGrid ItemsSource="{Binding AxisRows}" MaxHeight="320">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Axis" Binding="{Binding Name}" Width="110"/>
                    <DataGridTextColumn Header="Raw" Binding="{Binding Raw, StringFormat=F0}" Width="70"/>
                    <DataGridTextColumn Header="Center" Binding="{Binding Center, StringFormat=F1}" Width="70"/>
                    <DataGridTextColumn Header="Min" Binding="{Binding Min, StringFormat=F0}" Width="70"/>
                    <DataGridTextColumn Header="Max" Binding="{Binding Max, StringFormat=F0}" Width="70"/>
                    <DataGridTextColumn Header="Normalized" Binding="{Binding Normalized, StringFormat=F3}" Width="90"/>
                    <DataGridTextColumn Header="Assigned" Binding="{Binding Assigned}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </Border>
            <Border Style="{StaticResource Card}">
              <StackPanel>
                <TextBlock Text="Device info" Style="{StaticResource SectionTitle}"/>
                <TextBox Text="{Binding DeviceInfo}" IsReadOnly="True" AcceptsReturn="True" Height="160"
                         TextWrapping="Wrap" FontFamily="Consolas" FontSize="12" Margin="0,8,0,0"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
